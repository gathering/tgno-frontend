---
import Countdown from "../Countdown.astro";

interface Props {
  class?: string;
}

const { class: classNames } = Astro.props;
---

<div class={classNames}>
  <div
    class="bg-background-secondary flex flex-col sm:flex-row p-4 justify-center items-center rounded-3xl md:p-6 gap-4 md:gap-8 md:h-full md:m-auto md:rounded-2xl"
  >
    <Countdown
      targetDate="2027-03-24T09:00:00+01:00"
      confetti
      endMessage="TG27 er i gang!"
    >
      <h2 class="text-xl text-white font-bold" slot="pre">Sees i påsken!</h2>
    </Countdown>
  </div>
</div>
