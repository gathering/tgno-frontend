---
import Hero from "../Hero.astro";
import Button from "../../Button.astro";

interface Props {
  class?: string;
}

const { class: classNames } = Astro.props;
---

<Hero
  image="/images/blurry-lights.jpg"
  backgroundVideo={[
    { path: "/tg26/preview_video.webm", type: "video/webm" },
    { path: "/tg26/preview_video.mp4", type: "video/mp4" },
  ]}
  fullVideoHref="https://www.youtube.com/watch?v=mtDVFcYip8A"
  fullVideoText="Se TG26-teaseren på YouTube"
  class={classNames}
>
  <div class="flex flex-col text-left">
    <div class="w-full">
      <h2 class="text-4xl font-bold">Takk for i år!</h2>
      <p class="text-lg font-normal">Ta med deg stemning hjem på</p>
    </div>
    <aside class="mt-2 flex flex-col sm:flex-row gap-2">
      <Button
        href="https://www.youtube.com/@gatheringorg/featured"
        theme="white"
        variant="wide"
        class="w-full sm:w-auto">YouTube</Button
      >
      <Button
        href="https://discord.gg/gathering"
        theme="white"
        variant="wide"
        class="w-full sm:w-auto">Discord</Button
      >
      <Button
        href="https://www.tiktok.com/@gatheringorg"
        theme="white"
        variant="wide"
        class="w-full sm:w-auto">TikTok</Button
      >
    </aside>
  </div>
</Hero>
