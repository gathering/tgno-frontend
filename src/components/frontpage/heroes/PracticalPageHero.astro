---
import Hero from "../Hero.astro";
import Button from "../../Button.astro";
import { fetchInfoPageByPath } from "../../../utils";
import { API_URL } from "../../../utils/runtime-env";

interface Props {
  class?: string;
}

const { class: classNames } = Astro.props;
const path = "/practical/alt-om-innsjekk-og-ankomst-til-tg/";

const page = await fetchInfoPageByPath({
  path,
  apiUrl: API_URL,
}).catch((e) => {
  console.error(e.message);
});

const { intro, title, body, meta } = page || {};
---

{
  page ? (
    <Hero
      image="/images/blurry-lights.jpg"
      backgroundVideo={[
        { path: "/tg26/preview_video.webm", type: "video/webm" },
        { path: "/tg26/preview_video.mp4", type: "video/mp4" },
      ]}
      fullVideoHref="https://www.youtube.com/watch?v=mtDVFcYip8A"
      fullVideoText="Se TG26-teaseren på YouTube"
      class={classNames}
    >
      <div class="flex flex-col text-left">
        <div class="w-full">
          <h2 class="text-4xl font-bold">{title}</h2>
          {intro ? <p class="text-lg font-normal">{intro}</p> : <p>{body}</p>}
        </div>
        <aside class="mt-2 space-x-2">
          {meta?.url ? (
            <Button href={meta.url} theme="white">
              Få full oversikt
            </Button>
          ) : null}
        </aside>
      </div>
      <Fragment slot="cta">
        <p class="text-black">Besøke oss i påsken?</p>
        <Button
          href="https://www.geekevents.org/tg26/#/shop"
          theme="transparent"
        >
          Kjøp dagsbillett
        </Button>
      </Fragment>
    </Hero>
  ) : null
}
