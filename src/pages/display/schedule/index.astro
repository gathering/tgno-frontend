---
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  title="The Gathering - Program"
  headerVariant="hidden"
  footerVariant="hidden"
>
  <main
    class="min-h-screen flex items-center justify-center text-center text-white p-8"
  >
    <div class="max-w-3xl">
      <h1 class="text-4xl sm:text-6xl font-bold mb-4">Program</h1>
      <h2 class="text-2xl sm:text-4xl font-bold mb-6">
        Informasjonen er ikke klar ennå
      </h2>
      <p class="text-xl opacity-80">
        Programmet for TG27 publiseres her når det er klart.
      </p>
    </div>
  </main>
</Layout>
