---
import H1 from "../../components/H1.astro";
import Layout from "../../layouts/Layout.astro";
import Main from "../../components/Main.astro";
import H2 from "../../components/H2.astro";
import ContentContainer from "../../components/ContentContainer.astro";
---

<Layout title="The Gathering - Billetter">
  <Main>
    <ContentContainer>
      <div class="text-center">
        <H1 text="Billetter" />
      </div>
      <div class="max-w-3xl mx-auto">
        <section class="mb-6 prose text-center mx-auto">
          <H2 text="Informasjonen er ikke klar ennå" />
          <p class="text-xl">
            Detaljert informasjon om billetter til TG27 publiseres her når den
            er klar.
          </p>
          <p>
            Følg med på våre sosiale medier for oppdateringer om billettsalg og
            viktige datoer.
          </p>
        </section>
      </div>
    </ContentContainer>
  </Main>
</Layout>
